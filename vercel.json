{
  "version": 2,
  "routes": [
    { "src": "/api/auth/login", "dest": "/api/auth/login.js" },
    { "src": "/api/auth/logout", "dest": "/api/auth/logout.js" },
    { "src": "/api/auth/me", "dest": "/api/auth/me.js" },
    { "src": "/api/admin/usuarios", "dest": "/api/admin/usuarios.js" },
    { "src": "/api/jira", "dest": "/api/jira.js" },
    { "src": "/api/send-report", "dest": "/api/send-report.js" },
    { "src": "/data/(.*)", "status": 404 },
    { "src": "/login.html", "dest": "/public/login.html" },
    { "src": "/admin.html", "dest": "/public/admin.html" },
    { "src": "/sesion.js", "dest": "/public/sesion.js" },
    { "src": "/app.js", "dest": "/public/app.js" },
    { "src": "/costos.js", "dest": "/public/costos.js" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ],
  "crons": [
    { "path": "/api/send-report", "schedule": "0 21 * * 1" },
    { "path": "/api/send-report", "schedule": "0 23 * * 5" }
  ]
}
